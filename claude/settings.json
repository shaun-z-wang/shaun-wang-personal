    "ask": [
      "Bash(rm:*)",
      "Bash(isc:*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)"
    ],
    "additionalDirectories": [
      "/home/bento/.config/claude-code/skills"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/bento/.claude/hooks/fix-ssh-auth-sock.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bento/.claude/hooks/fix-ssh-auth-sock.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r FILE; if [[ \"$FILE\" == /home/bento/carrot/* ]] && cd /home/bento/carrot && [ \"$(git branch --show-current)\" = \"master\" ]; then echo '{\"decision\":\"block\",\"reason\":\"You are on master in carrot. Run graft to create a worktree first.\"}'; fi; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bento/.claude/plugins/marketplaces/instacart/code-chef/hooks/scripts/pre-bash-guard.sh",
            "timeout": 10,
            "statusMessage": "Checking guardrails..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/bento/.claude/plugins/marketplaces/instacart/code-chef/hooks/scripts/code-chef-enforcer.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/bento/.claude/plugins/marketplaces/instacart/code-chef/hooks/scripts/session-autosave.sh",
            "timeout": 10,
            "async": true
          },
          {
            "type": "command",
            "command": "/home/bento/.claude/plugins/marketplaces/instacart/code-chef/hooks/scripts/layer-notify.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "annual-reviews@instacart": true,
    "datadog@instacart": true,
    "doc-review@instacart": true,
    "doc-writer@instacart": true,
    "google-docs@instacart": false,
    "slack@instacart": false,
    "rca-collaborator@instacart": true,
    "code-chef@instacart": true,
    "graft@instacart": true,
    "tmux-status@instacart": true,
    "thyme@instacart": true,
    "gws@instacart": true,
    "pastry@instacart": true,
    "enterprise-platform-monitor-review@instacart": true
  },
  "extraKnownMarketplaces": {
    "instacart": {
      "source": {
        "source": "github",
        "repo": "instacart/claude-marketplace"
      }
    }
  },
  "effortLevel": "high",
  "showClearContextOnPlanAccept": true,
  "theme": "light"
}
